[user]
	name = pabsan-0
	email = 63670587+pabsan-0@users.noreply.github.com

[url "https://github.com/pabsan-0/"]
   insteadOf = ps:

[url "https://github.com/"]
   insteadOf = gh:

[include]
    path = ~/.gitconfig-antexia

[init]
	defaultBranch = master

[core]
	editor = vim
[credential]
	helper = store

[alias]
    s    = status
    co   = checkout
    cc   = commit
    cp   = cherry-pick
    d    = diff
    ds   = diff --staged

    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    dog = log --graph --decorate --date=short --pretty=format:'%C(yellow)%h%C(reset) %C(cyan)%ad%C(reset) %C(auto)%d%C(reset) %s'
    adog = log --all --graph --decorate --date=short --pretty=format:'%C(yellow)%h%C(reset) %C(cyan)%ad%C(reset) %s %C(auto)%d%C(reset)'
    adogs = adog -7

    wa    = git worktree add
    wls   = ! git --git-dir=$(echo ./*.git) worktree list
    wadog = ! git --git-dir=$(echo ./*.git) log --all --decorate --oneline --graph

[rerere]
	enabled = true
